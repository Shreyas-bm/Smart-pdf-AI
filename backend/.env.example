# Database Configuration
# For local SQLite development (default):
DATABASE_URL=sqlite:///./test.db
# For production PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Storage Settings (Optional - falls back to local database/file storage if not set)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=mock_access_key
S3_SECRET_ACCESS_KEY=mock_secret_key
S3_BUCKET_NAME=smart-pdf-bucket
S3_REGION_NAME=us-east-1

# JWT Authentication (Used if authentication is enabled, local-first bypasses this by default)
JWT_SECRET=supersecretjwtkeyforlocaldevelopmentonlychangeinprod
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=10080

# CORS settings
CORS_ORIGINS=["*"]

# Redis / Celery (Optional - background tasks run synchronously in-process if Celery is not running)
REDIS_URL=redis://localhost:6379/0

# Embedding model settings
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5

# Large Language Model (LLM) Settings
# Provider options: auto, openai, ollama, mock (auto will detect and use OpenAI if key is present, otherwise Ollama/Mock)
LLM_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_BASE_URL=
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=gpt-4o-mini
